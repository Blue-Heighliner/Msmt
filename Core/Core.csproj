<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BlueHeighliner.Msmt</RootNamespace>
    <AssemblyName>BlueHeighliner.Msmt</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>BlueHeighliner.Msmt</PackageId>
    <Version>0.1.0</Version>
    <Authors>Chris Markwardt</Authors>
    <Description>C# implementation of the Mercury Secure Message Transport (MSMT) protocol: a TLS 1.3-based secure message transport interface standardized by MITRE.</Description>
    <PackageTags>msmt;networking;tls;protocol;security</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Blue-Heighliner/Msmt</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Blue-Heighliner/Msmt</PackageProjectUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
